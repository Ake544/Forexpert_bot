# Copy to config/.env (git-ignored) and fill in. Never commit real values.
# Every ${VAR} in config.yaml is resolved from the environment, and config/.env
# is loaded automatically at startup.

TWELVE_DATA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# MetaTrader 5 (FX volume feed). Leave empty if the terminal is already logged
# into the right account — the source will reuse that session.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=